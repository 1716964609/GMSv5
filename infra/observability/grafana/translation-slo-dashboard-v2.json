        "spec": {
          "id": 1,
          "title": "Translation SLO Attainment — Rolling 7d",
          "description": "Successful server-side translations completed within 10 seconds, rolling 7 days",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "100 *\nsum(\n  increase(\n    gms_translation_duration_seconds_bucket{\n      gms_translation_outcome=\"success\",\n      le=\"10.0\"\n    }[7d]\n  )\n)\n/\nsum(\n  increase(\n    gms_translation_duration_seconds_count{\n      gms_translation_outcome=\"success\"\n    }[7d]\n  )\n)",
                        "instant": true,
                        "legendFormat": "Translation SLO Attainment — Rolling 7d",
                        "range": false
                      }
                    },
                    "refId": "Translation SLO Attainment — Rolling 7d",
                    "hidden": false
                  }
