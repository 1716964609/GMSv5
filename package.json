{
  "name": "gmsv5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "@next/swc-darwin-arm64": true,
    "@tailwindcss/oxide": true,
    "@tailwindcss/oxide-darwin-arm64": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "accounts:purge": "node --experimental-strip-types scripts/purge-accounts.ts",
    "test:db": "node --experimental-strip-types --test test/db-migration.test.ts",
    "test:usecases": "node --experimental-strip-types --test test/use-cases.test.ts",
    "test:browserless": "node --experimental-strip-types --test test/browserless.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@playwright/test": "^1.64.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
