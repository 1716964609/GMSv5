# SQLite
GMS_DATABASE_PATH=/mnt/gms-data/gmsv5.sqlite

# Session and API credential encryption. Generate random values; never commit them.
SESSION_SECRET=replace-with-at-least-32-random-characters
GMS_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Amazon Cognito Hosted UI / OIDC
COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-1.amazoncognito.com
COGNITO_CLIENT_ID=replace-with-cognito-client-id
COGNITO_CLIENT_SECRET=
COGNITO_REGION=ap-northeast-1
COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/your-user-pool-id
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/

# External translation providers (the user's encrypted credentials are preferred).
# Production: use the dedicated IPv6 CloudFront proxy for DeepL.
DEEPL_API_URL=https://d7xjhnc06nb75.cloudfront.net/v2/translate
# Required for the production DeepL proxy. Server-side only; never use NEXT_PUBLIC_*.
DEEPL_PROXY_TOKEN=
# For local direct DeepL access, use:
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# BYO Term fetch worker count for Platform comparisons: 1, 2, or 4 (default 2).
# All operations in the same tab share a maximum of 4 active Term requests.
NEXT_PUBLIC_GMS_TERM_FETCH_CONCURRENCY=2

# Application telemetry (OpenTelemetry). Disabled unless GMS_OTEL_ENABLED=true.
# Design and schema: docs/observability/application-instrumentation.md
# GMS_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Collector auth header(s); secret — keep out of the repository.
# Values are URL-encoded, e.g. authorization=Bearer%20<token>
# OTEL_EXPORTER_OTLP_HEADERS=
# PEM CA bundle that signs the Collector's TLS certificate (traces + metrics).
# Prefer this over NODE_EXTRA_CA_CERTS, which widens trust for the whole process.
# OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/gmsv5/otel-collector-ca.pem
# GMS_RELEASE_VERSION=
# GMS_DEPLOYMENT_ENVIRONMENT=development
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1
# GMS_OTEL_METRICS_EXPORT_INTERVAL_MS=30000
# Server-side acceptance of Browser RUM beacons (requires GMS_OTEL_ENABLED=true).
# GMS_RUM_ENABLED=true
# Browser RUM is a build-time setting (NEXT_PUBLIC_*).
# NEXT_PUBLIC_GMS_RUM_ENABLED=true
# NEXT_PUBLIC_GMS_RUM_SAMPLE_RATE=1
